# ==============================================================================
# EnterpriseAI-recsys Environment Configuration
# ==============================================================================

# 1. API SERVER CONFIGURATION
PORT=9985
HOST=0.0.0.0
DEBUG=false

# 2. ORACLE AUTONOMOUS DATABASE (ADB 23ai)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SCHEMA=RECSYS_NEW
WALLET_PASSWORD=your_wallet_password
WALLET_DIR=Wallet_CLOUDEX
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30

# Oracle Autonomous Database TCPS Connection Descriptor
DB_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.us-phoenix-1.oraclecloud.com))(connect_data=(service_name=your_service_name_medium.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# 3. OCI CONFIGURATION & REGIONS
OCI_CONFIG_FILE=config
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-phoenix-1
COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid
BUCKET_NAME=your_object_storage_bucket_name

# 4. OCI GENERATIVE AI (LLM INFERENCE & DENSE EMBEDDINGS)
LLM_BASE_URL=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com/openai/v1
LLM_API_KEY=your_oci_genai_api_key
LLM_PROJECT_ID=ocid1.generativeaiproject.oc1.phx..your_project_ocid
MODEL_NAME=openai.gpt-oss-120b
ENDPOINT=https://inference.generativeai.me-riyadh-1.oci.oraclecloud.com
EMBEDDING_MODEL_ID=cohere.embed-v4.0
VECTOR_DIMENSION=1024

# 5. LANGFUSE OBSERVABILITY & TELEMETRY
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PROJECT_FLAG=EnterpriseAI_RecSys
